{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Plan",
  "version": "0.2.0",
  "identifier": "app.dailyplan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daily Plan",
        "width": 420,
        "height": 520,
        "minWidth": 320,
        "minHeight": 360,
        "center": true,
        "alwaysOnTop": true,
        "resizable": true,
        "closable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Записная книжка для быстрых задач на день",
    "longDescription": "Daily Plan — компактная записная книжка для ежедневных задач. Ввод по глобальной горячей клавише, календарь с тепловой картой, переносы задач и комментарии. Данные хранятся локально в SQLite.",
    "copyright": "© 2026 Daily Plan",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:daily-plan.db"
      ]
    }
  }
}
